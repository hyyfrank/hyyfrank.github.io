{{- /* Fuse.js search index: published posts in mainSections only */ -}}
{{- $sections := site.Params.mainSections | default (slice "post") -}}
{{- $.Scratch.Add "index" slice -}}
{{- range where site.RegularPages "Section" "in" $sections -}}
  {{- if and (eq .Kind "page") (not .Params.searchHidden) (ne .Layout "archives") (ne .Layout "search") -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "content" .Plain "permalink" .Permalink "summary" .Summary) -}}
  {{- end -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
